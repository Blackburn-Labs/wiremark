{
  "name": "@wiremark/cli",
  "version": "0.0.6",
  "description": "Command-line renderer for the wiremark wireframe DSL: turn a .wiremark file into a hand-drawn SVG.",
  "homepage": "https://wiremark.dev",
  "bugs": "https://github.com/Blackburn-Labs/wiremark/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackburn-Labs/wiremark.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": {
    "name": "Blackburn Labs",
    "url": "https://www.blackburnlabs.com"
  },
  "type": "module",
  "bin": {
