Wireframe #shell landscape visible=false
  AppBar
    Toolbar
      Typography h6 "Acme"
  Stack row 100% *
    Box 240px *
      List
        ListItem "Home"
        ListItem "Reports"
      Anchor #side
    Anchor #content

Wireframe #login landscape
  Stack column spacing=2
    Typography h4 "Sign in"
    TextField "Email"
    TextField "Password"
    Stack row spacing=3
      Control
      Typography body2 "Remember me"
      Spacer
      Link "Forgot?" to=#reset
    Button "Sign in" contained to=#home
    Divider
    Typography ~2

Wireframe #home background=#shell anchor=#content
  Typography h1 "Dashboard"
  Grid cols=3
    Card to=#details
    Card to=#details
    Card to=#product

Wireframe #details background=#shell anchor=#content
  Stack column spacing=3
    Link "Back" to=#home
    Typography h1 "Item Details"
  Typography ~16

Wireframe #product background=#shell anchor=#content
  Card
    Img ratio=16:9
    CardContent
      Typography h5 "Product name"
    CardActions
      Button "Buy" contained
      Button "Details" variant=outlined to=#detail
