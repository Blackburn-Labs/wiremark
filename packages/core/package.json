{
  "name": "@wiremark/core",
  "version": "0.0.6",
  "description": "Core parser, layout engine, and hand-drawn SVG renderer for the wiremark wireframe DSL. Pure JS, no host dependencies.",
  "homepage": "https://wiremark.dev",
  "bugs": "https://github.com/Blackburn-Labs/wiremark/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackburn-Labs/wiremark.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": {
    "name": "Blackburn Labs",
    "url": "https://www.blackburnlabs.com"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli.js",
    "./browser": "./dist/wiremark.browser.js"
  },
  "files": [
    "src",
    "dist/wiremark.browser.js"
  ],
  "scripts": {
    "test": "node --test",
    "build:browser": "node scripts/build-browser.mjs",
    "prepack": "npm run build:browser"
  },
  "keywords": [
    "wireframe",
    "dsl",
    "mui",
    "svg",
    "markdown",
    "sketch",
    "balsamiq",
    "mockup"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
