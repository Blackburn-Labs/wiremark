        {
          "name": "orientation",
          "type": "enum",
          "values": [
            "vertical",
            "horizontal"
          ],
          "default": "vertical",
          "keyless": true,
          "notes": "v1.0. Panel axis: vertical=tall narrow side panel, horizontal=wide short panel. anchor implies and overrides it when both are given."
