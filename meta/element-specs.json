          "values": [
            "permanent",
            "overlay",
            "rail"
          ],
          "default": "permanent",
          "keyless": true,
          "notes": "v1.0. permanent=in-flow panel; overlay=out-of-flow, pinned to anchor; rail=thin in-flow strip."
