{
  "name": "@wiremark/docs-site",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for wiremark (Docusaurus). Reads the repo's ../docs folder in place; the component reference is regenerated from meta/element-specs.json on every build.",
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "node ../scripts/generate-reference.mjs",
    "start": "docusaurus start",
    "prebuild": "node ../scripts/generate-reference.mjs",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "^3.6.0",
    "@docusaurus/preset-classic": "^3.6.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18.0"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
